# Путь к хранилищу пакетов pnpm
# Переопределяем стандартный путь, так как докер при создании образа
# использует пользователя root, и по умолчанию pnpm пытается создать
# хранилище в домашней папке root, что не очень хорошо.
# Лучше хранить в отдельной папке, которая монтируется в докер-контейнер
# как volume (том) и не теряется при пересоздании контейнера
# и не требует прав суперпользователя.

store-dir=/pnpm-store