/*
 * Guide: https://marketplace.visualstudio.com/items?itemName=ms-vscode-remote.remote-containers
 */
{
  "name": "Servicelead",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.local.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  "containerEnv": {
    "HTTP_PROXY": "http://host.docker.internal:1082",
    "HTTPS_PROXY": "http://host.docker.internal:1082",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "nuxtr.nuxtr-vscode",
        "openai.chatgpt",
        "stylelint.vscode-stylelint",
        "mrmlnc.vscode-scss",
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "editor": {
          "codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.fixAll.stylelint": "explicit"
          }
        },
        "stylelint": {
          "configFile": "./stylelint.config.mjs",
          "validate": [
            "scss",
            "vue"
          ]
        },
        "eslint": {
          "useFlatConfig": true
        }
      }
    }
  }
}
