/*
 * Guide: https://marketplace.visualstudio.com/items?itemName=ms-vscode-remote.remote-containers
 */
{
  "name": "Servicelead",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.local.yml"],
  "service": "web",
  "workspaceFolder": "/app",
  "containerEnv": {
    "HTTP_PROXY": "http://host.docker.internal:1082",
    "HTTPS_PROXY": "http://host.docker.internal:1082",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,readonly",
    // use host codex settings
    "source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind"
  ],
  // One-time: add GitHub host key to avoid prompt; fix OpenSSH perms.
  "postCreateCommand": "mkdir -p ~/.ssh && chmod 700 ~/.ssh && (ssh-keyscan -H github.com >> ~/.ssh/known_hosts || true) && (chmod 600 ~/.ssh/* 2>/dev/null || true)",

  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "nuxtr.nuxtr-vscode",
        "openai.chatgpt",
        "stylelint.vscode-stylelint",
        "mrmlnc.vscode-scss",
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "editor": {
          "codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.fixAll.stylelint": "explicit"
          }
        },
        "stylelint": {
          "configFile": "./stylelint.config.mjs",
          "validate": [
            "scss",
            "vue"
          ]
        },
        "eslint": {
          "useFlatConfig": true
        }
      }
    }
  }
}
